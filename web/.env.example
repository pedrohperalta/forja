# @forja/web environment.
# Copy to `.env.local` and fill in real values. Validated by src/server/env.ts
# (ServerEnvSchema) at runtime — every variable below is required.

# Public base URL of the web app (used to build OAuth redirect URIs).
FORJA_PUBLIC_URL=http://localhost:3000

# Postgres connection string.
DATABASE_URL=postgres://forja:forja@localhost:5432/forja

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated allowlists of Google emails.
# ALLOWED_USER_EMAILS may sign in to the mobile app; ADMIN_EMAILS may use the web admin.
FORJA_ALLOWED_USER_EMAILS=you@example.com
FORJA_ADMIN_EMAILS=you@example.com

# Independent secrets for signing/HMAC. Generate distinct random values, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FORJA_ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
FORJA_REFRESH_TOKEN_SECRET=replace-with-a-long-random-string
FORJA_ADMIN_SESSION_SECRET=replace-with-a-long-random-string
FORJA_AUTH_CODE_SECRET=replace-with-a-long-random-string
FORJA_OAUTH_STATE_SECRET=replace-with-a-long-random-string
FORJA_SYNC_CURSOR_SECRET=replace-with-a-long-random-string
