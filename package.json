{
  "name": "forja",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "mobile",
    "web",
    "packages/*"
  ],
  "scripts": {
    "test": "pnpm --filter @forja/mobile test",
    "typecheck": "pnpm --filter @forja/mobile typecheck",
    "lint": "pnpm --filter @forja/mobile lint",
    "check:slice0": "node --test scripts/check-slice0-workspace.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "lefthook": "2.1.4",
    "prettier": "3.8.1"
  }
}
